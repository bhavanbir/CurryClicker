# Build target: "full" (default, complete game) or "demo" (offline web demo
# that hides online screens — Leaderboard, Login — and the Cosmetics store
# section, and shows a "get it on Steam" CTA instead). See src/target.ts.
VITE_TARGET=full

# Where the demo's Steam CTAs link. Replace with the real store page once live.
# VITE_STEAM_URL=https://store.steampowered.com/app/XXXXXX/Curry_Clicker/

# Length of one simulated in-game week, in milliseconds.
# Dev default (set in src/config.ts) is 7 minutes = 420000ms so the
# day / week loop is observable. Production would use 604800000 (real 7 days).
VITE_WEEK_DURATION_MS=420000

# --- Backend (NOT used by the MVP core loop — present for later phases) ---
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
# VITE_TURNSTILE_SITE_KEY=
# VITE_STRIPE_PUBLISHABLE_KEY=
