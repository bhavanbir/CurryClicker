{
  "name": "curry-clicker",
  "private": true,
  "version": "0.8.0",
  "type": "module",
  "main": "electron/main.cjs",
  "description": "Curry Clicker — Spicetone Arcade. MVP core loop (cook & click).",
  "scripts": {
    "dev": "vite",
    "dev:demo": "vite --mode demo",
    "build": "tsc -b && vite build",
    "build:demo": "tsc -b && vite build --mode demo",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "desktop:dev": "node scripts/desktop-dev.mjs",
    "desktop:build": "npm run build && electron-builder"
  },
  "dependencies": {
    "framer-motion": "^11.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "steamworks.js": "^0.4.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "4.7",
    "autoprefixer": "^10.4.19",
    "electron": "^31.7.7",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.5.4",
    "vite": "^6.4.3"
  },
  "build": {
    "appId": "com.spicetone.curryclicker",
    "productName": "Curry Clicker",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "asarUnpack": [
      "node_modules/steamworks.js/**"
    ],
    "extraFiles": [
      {
        "from": "public/THIRD-PARTY-LICENSES.txt",
        "to": "THIRD-PARTY-LICENSES.txt"
      }
    ],
    "win": {
      "target": "nsis"
    }
  }
}
